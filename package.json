{
  "name": "math-survival-2",
  "version": "3.0.2",
  "description": "Static educational canvas game based on ysschool Math Survival",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-2.1.cjs",
    "test:devices": "node tests/mobile-tablet.cjs",
    "test:preferences": "node tests/preferences.cjs",
    "test:typography": "node tests/typography.cjs",
    "test:baseline": "node tests/baseline.cjs",
    "build": "node scripts/build.mjs",
    "bank:generate": "node scripts/question-bank.mjs",
    "test:movement": "node tests/movement.cjs",
    "test:sprites": "node tests/sprites.cjs",
    "test:curriculum-screen": "node tests/curriculum-screen.cjs",
    "test:v3": "node tests/v3-browser.cjs && node tests/v3-math-browser.cjs && node tests/v3-content-browser.cjs && node tests/v3-progress-browser.cjs && node tests/v3-teacher-browser.cjs && node tests/v3-followup-browser.cjs && node tests/v3-balance-browser.cjs",
    "test:stress": "node tests/v3-stress.cjs",
    "test:build-browser": "node tests/v3-build-browser.cjs",
    "test:playtest": "node tests/v3-playtest.cjs",
    "test:simple-play": "node tests/simple-play.cjs",
    "test:startup": "node tests/startup.cjs"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "devDependencies": {
    "acorn": "^8.19.0",
    "eslint-scope": "^9.1.2",
    "playwright": "^1.64.0"
  },
  "private": true
}
